// Type-checks tests/ (CI typecheck job and pre-commit). Files under "exclude" after
// node_modules and dist still had type errors when this gate was added: fix one and
// delete its line. Don't add new entries.
{
  "extends": "./tsconfig.tests.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["vitest/globals", "node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "apps/playground/src/vite-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Generated from the docs by docs:extract-tests and gitignored; CI's docs job runs it.
    "tests/docs/extracted.test.ts",
    // These import brepjs-bim, -sheetmetal, and -families, whose types come from builds
    // that the CI typecheck job doesn't run (vitest aliases them to src instead).
    "tests/helpers/playgroundExampleEval.ts",
    "tests/playgroundExamples.test.ts",
    "tests/validateCandidate.test.ts",
    "tests/historyRefReplay.test.ts",
    "tests/historyReplay.test.ts",
    "tests/ikFns.test.ts",
    "tests/importFns.test.ts",
    "tests/instanceFns.test.ts",
    "tests/jointFns.test.ts",
    "tests/kernel-agreement.test.ts",
    "tests/kernelCall.test.ts",
    "tests/loftFns.test.ts",
    "tests/mateFns.test.ts",
    "tests/measureFns.test.ts",
    "tests/measurement.test.ts",
    "tests/meshCache.test.ts",
    "tests/modifierFns.test.ts",
    "tests/objImport.test.ts",
    "tests/occtWasmAdoptShape.test.ts",
    "tests/occtWasmBooleanOp.test.ts",
    "tests/offsetWire2D.test.ts",
    "tests/operations-extrude.test.ts",
    "tests/originGeometricFallback.test.ts",
    "tests/origins.test.ts",
    "tests/parity/composedTransformParity.test.ts",
    "tests/parity/manifold.test.ts",
    "tests/parity/nativeEdges.test.ts",
    "tests/parity/nativeFaces.test.ts",
    "tests/parity/planeExtrudeOrientation.test.ts",
    "tests/parity/profileExtrude.test.ts",
    "tests/parity/roundtrip.test.ts",
    "tests/parity/transforms.test.ts",
    "tests/primitiveFns.test.ts",
    "tests/public-api-types.test.ts",
    "tests/shapeFns.test.ts",
    "tests/shapeRefExtrudeRoles.test.ts",
