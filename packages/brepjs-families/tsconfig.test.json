{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "brepjs-families",
    "paths": {
      "brepjs-families/jsx-runtime": ["./src/jsxRuntime.ts"],
      "brepjs-families/jsx-dev-runtime": ["./src/jsxRuntime.ts"],
      "brepjs-families": ["./src/index.ts"],
      "@/*": ["../../src/*"],
      "brepjs": ["../../src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "registry/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
