{
  "name": "brepjs-mesh2solid",
  "version": "0.1.0",
  "private": true,
  "description": "Mesh-to-solid conversion for brepjs: turn STL, OBJ, PLY and 3MF meshes (CAD exports or 3D scans) into B-Rep solids. Includes a Rust → WebAssembly mesh engine.",
  "keywords": [
    "mesh",
    "stl",
    "step",
    "3mf",
    "cad",
    "brep",
    "reverse-engineering",
    "3d-scan"
  ],
  "author": "Andy Aragon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andymai/brepjs",
    "directory": "packages/brepjs-mesh2solid"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/brepjs-mesh2solid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/brepjs-mesh2solid.js"
    },
    "./index_bg.wasm": "./wasm/index_bg.wasm"
  },
  "files": [
    "dist",
    "wasm/index.js",
    "wasm/index.d.ts",
    "wasm/index_bg.wasm",
    "wasm/index_bg.wasm.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build",
    "build:engine": "bash engine/scripts/build.sh",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "peerDependencies": {
    "brepjs": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@types/node": "26.6.5",
    "eslint": "*",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
