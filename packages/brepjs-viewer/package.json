{
  "name": "brepjs-viewer",
  "version": "0.3.0",
  "description": "Shared React/R3F renderer for brepjs meshes (used by the playground and the brepjs-agent viewer)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andymai/brepjs",
    "directory": "packages/brepjs-viewer"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/brepjs-viewer.cjs",
  "module": "./dist/brepjs-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/brepjs-viewer.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/brepjs-viewer.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.184"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/test-renderer": "9.1.1",
    "@types/react": "19.2.18",
    "@types/three": "0.185.4",
    "eslint": "*",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "typescript": "*",
    "typescript-eslint": "*",
    "vite": "^8.0.0",
    "vite-plugin-dts": "*",
    "vitest": "^4.0.0"
  }
}
