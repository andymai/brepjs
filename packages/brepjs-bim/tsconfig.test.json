{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
